# Copier vers .env puis éditer :
#   cp .env.example .env

POSTGRES_DB=os_gateway
POSTGRES_USER=osgateway
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

RABBITMQ_USER=osgateway
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBIT_PASSWORD

# ≥ 32 caractères
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS_LONG!!

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -Xms128m -Xmx512m

RATE_LIMIT_RPM=2000
RATE_LIMIT_ENABLED=false

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Optionnel FCM (fichier dans ./secrets/)
# FIREBASE_CREDENTIALS_PATH=/secrets/firebase-adminsdk.json
# FIREBASE_CREDENTIALS_JSON=
