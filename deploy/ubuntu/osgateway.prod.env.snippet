# ==================================================
# OS GATEWAY (osgateway.olive-services.net)
# À ajouter dans /home/adminubuntu/OliveApps/prod.env
# ==================================================

OSGATEWAY_HOST=osgateway.olive-services.net
OSGATEWAY_DB=os_gateway
OSGATEWAY_DB_USER=osgateway
OSGATEWAY_DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

OSGATEWAY_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS_LONG!!

OSGATEWAY_RABBITMQ_USER=osgateway
OSGATEWAY_RABBITMQ_PASS=CHANGE_ME_STRONG_RABBIT_PASSWORD

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -Xms128m -Xmx512m
RATE_LIMIT_RPM=2000
RATE_LIMIT_ENABLED=false

# Optionnel FCM
# FIREBASE_CREDENTIALS_PATH=/secrets/firebase-adminsdk.json

# Chemins VPS (Jenkins Deploy)
# Backend repo : /home/adminubuntu/OliveApps/OSGATEWAY/backend
# Frontend WWW : /var/www/osgateway/frontend
