# ==================================================
# OS GATEWAY (osgateway.olive-services.net)
# À coller dans /home/adminubuntu/OliveApps/prod.env
# ==================================================
OSGATEWAY_HOST=osgateway.olive-services.net
OSGATEWAY_DB=os_gateway
OSGATEWAY_DB_USER=osgateway
OSGATEWAY_DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD
OSGATEWAY_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
OSGATEWAY_RABBITMQ_USER=osgateway
OSGATEWAY_RABBITMQ_PASS=CHANGE_ME_STRONG_RABBIT_PASSWORD
OSGATEWAY_JAVA_OPTS=-XX:MaxRAMPercentage=70 -Xms128m -Xmx512m
OSGATEWAY_RATE_LIMIT_RPM=2000
OSGATEWAY_RATE_LIMIT_ENABLED=false
OSGATEWAY_SECRETS_HOST_PATH=/home/adminubuntu/OliveApps/OSGATEWAY/secrets
OSG_TAG=latest
